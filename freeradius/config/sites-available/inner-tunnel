# sites-available/inner-tunnel - Servidor virtual para EAP inner tunnel (TTLS/PEAP)

server inner-tunnel {
  listen {
    ipaddr   = 127.0.0.1
    port     = 18120
    type     = auth
  }

  authorize {
    filter_username
    chap
    mschap
    suffix
    eap {
      ok = return
    }
    files
    sql
    expiration
    logintime
    pap
  }

  authenticate {
    Auth-Type PAP {
      pap
    }
    Auth-Type CHAP {
      chap
    }
    Auth-Type MS-CHAP {
      mschap
    }
    eap
  }

  session {
    sql
  }

  post-auth {
    sql
    Post-Auth-Type REJECT {
      sql
      attr_filter.access_reject
    }
  }

  pre-proxy {}
  post-proxy {
    eap
  }
}
