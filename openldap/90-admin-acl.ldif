dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn.exact="cn=admin,dc=empresa,dc=local" write by group.exact="cn=admins-acl,ou=groups,dc=empresa,dc=local" write by anonymous auth by * none
olcAccess: {1}to * by group.exact="cn=admins-acl,ou=groups,dc=empresa,dc=local" write by dn.exact="cn=admin,dc=empresa,dc=local" write by dn.exact="cn=readonly,dc=empresa,dc=local" read by * none
